diff --git a/Sources/Slotstream/Q8Attention.swift b/Sources/Slotstream/Q8Attention.swift
new file mode 100644
index 0000000..869e0bb
--- /dev/null
+++ b/Sources/Slotstream/Q8Attention.swift
@@ -0,0 +1,91 @@
+import MLX
+
+/// Split-key online softmax over packed Q8. Sparse-invisible keys are skipped
+/// before loading their payload. Each SIMD group owns 128 keys and one query;
+/// a second dispatch combines its stable softmax statistics in FP32.
+package enum Q8Attention {
+    private final class Kernels: Sendable {
+        static let shared = Kernels()
+        let partial = MLXFast.metalKernel(name: "slotstream_q8_attention_partial",
+            inputNames: ["query", "key", "value", "ks", "kb", "vs", "vb", "mask", "meta"],
+            outputNames: ["partial"], source: """
+            uint lane = thread_index_in_simdgroup;
+            uint work = thread_position_in_grid.x / 32;
+            int N = meta[0], capacity = meta[1], S = meta[2], H = meta[3];
+            int HK = meta[4], parts = meta[5], masked = meta[6];
+            int part = work % parts, row = work / parts;
+            int pos = row % S, head = (row / S) % H, batch = row / (S * H);
+            int kh = batch * HK + head / (H / HK);
+            int start = part * 128, end = min(start + 128, N - S + pos + 1);
+            float q[8], acc[8];
+            for (int d = 0; d < 8; ++d) {
+                q[d] = float(query[row * 256 + d * 32 + lane]) * 0.0625f;
+                acc[d] = 0.0f;
+            }
+            float maximum = -INFINITY, denominator = 0.0f;
+            for (int index = start; index < end; ++index) {
+                if (masked && !mask[(batch * S + pos) * N + index]) continue;
+                int wordBase = (kh * capacity + index) * 64;
+                int scaleBase = (kh * capacity + index) * 4;
+                float dot = 0.0f;
+                for (int d = 0; d < 8; ++d) {
+                    int channel = d * 32 + lane, group = channel / 64;
+                    uint word = key[wordBase + channel / 4];
+                    float quant = float((word >> ((channel % 4) * 8)) & 255);
+                    float k = float(InT(quant * float(ks[scaleBase + group]) + float(kb[scaleBase + group])));
+                    dot += q[d] * k;
+                }
+                dot = simd_sum(dot);
+                float next = max(maximum, dot);
+                float correction = maximum == -INFINITY ? 0.0f : exp(maximum - next);
+                float weight = exp(dot - next);
+                denominator = denominator * correction + weight;
+                for (int d = 0; d < 8; ++d) {
+                    int channel = d * 32 + lane, group = channel / 64;
+                    uint word = value[wordBase + channel / 4];
+                    float quant = float((word >> ((channel % 4) * 8)) & 255);
+                    float v = float(InT(quant * float(vs[scaleBase + group]) + float(vb[scaleBase + group])));
+                    acc[d] = acc[d] * correction + weight * v;
+                }
+                maximum = next;
+            }
+            int outputBase = work * 258;
+            for (int d = 0; d < 8; ++d) partial[outputBase + d * 32 + lane] = acc[d];
+            if (lane == 0) { partial[outputBase + 256] = maximum; partial[outputBase + 257] = denominator; }
+            """)
+        let reduce = MLXFast.metalKernel(name: "slotstream_q8_attention_reduce",
+            inputNames: ["partial", "meta"], outputNames: ["output"], source: """
+            uint channel = thread_position_in_grid.x % 256;
+            uint row = thread_position_in_grid.x / 256;
+            int parts = meta[5];
+            float maximum = -INFINITY;
+            for (int p = 0; p < parts; ++p) maximum = max(maximum, partial[(row * parts + p) * 258 + 256]);
+            float numerator = 0.0f, denominator = 0.0f;
+            for (int p = 0; p < parts; ++p) {
+                int base = (row * parts + p) * 258;
+                float sum = partial[base + 257];
+                if (sum == 0.0f) continue;
+                float weight = exp(partial[base + 256] - maximum);
+                numerator += partial[base + channel] * weight;
+                denominator += sum * weight;
+            }
+            output[row * 256 + channel] = InT(denominator > 0.0f ? numerator / denominator : 0.0f);
+            """)
+    }
+
+    package static func execute(q: MLXArray, cache: KVCache, mask: MLXArray?) -> MLXArray {
+        let parts = (cache.offset + 127) / 128
+        let meta = MLXArray([cache.offset, cache.keys!.dim(2), q.dim(2), q.dim(1),
+            cache.keys!.dim(1), parts, mask == nil ? 0 : 1].map(Int32.init))
+        let rows = q.dim(0) * q.dim(1) * q.dim(2)
+        let kernels = Kernels.shared
+        let partial = kernels.partial(
+            [q, cache.keys!, cache.values!, cache.keyScales!, cache.keyBiases!,
+             cache.valueScales!, cache.valueBiases!, mask ?? MLXArray([false]), meta],
+            template: [("InT", q.dtype)], grid: (rows * parts * 32, 1, 1), threadGroup: (32, 1, 1),
+            outputShapes: [[rows, parts, 258]], outputDTypes: [.float32])[0]
+        return kernels.reduce([partial, meta], template: [("InT", q.dtype)],
+            grid: (rows * 256, 1, 1), threadGroup: (256, 1, 1),
+            outputShapes: [q.shape], outputDTypes: [q.dtype])[0]
+    }
+}
diff --git a/Sources/SlotstreamDiagnostics/Diagnostics+Q8Cache.swift b/Sources/SlotstreamDiagnostics/Diagnostics+Q8Cache.swift
new file mode 100644
index 0000000..58dcf4b
--- /dev/null
+++ b/Sources/SlotstreamDiagnostics/Diagnostics+Q8Cache.swift
@@ -0,0 +1,93 @@
+import Foundation
+import MLX
+import MLXFast
+import Slotstream
+
+extension Diagnostics {
+    public static func q8Cache() -> CheckReport {
+        var c = CheckBuilder("q8-cache")
+        func tensor(_ rows: Int, _ phase: Float = 0, heads: Int = 2) -> MLXArray {
+            let data = (0..<(heads * rows * 256)).map { i in
+                sin(Float(i) * 0.073 + phase) * 2 + cos(Float(i) * 0.019) * 0.4
+            }
+            return MLXArray(data).reshaped([1, heads, rows, 256]).asType(.bfloat16)
+        }
+        func delta(_ a: MLXArray, _ b: MLXArray) -> Float {
+            abs(a.asType(.float32) - b.asType(.float32)).max().item(Float.self)
+        }
+        func same(_ a: KVCache, _ b: KVCache) -> Bool {
+            a.offset == b.offset && zip(a.storage, b.storage).allSatisfy {
+                let lhs = $0[0..., 0..., 0..<a.offset, 0...]
+                let rhs = $1[0..., 0..., 0..<b.offset, 0...]
+                return all(lhs .== rhs).item(Bool.self)
+            }
+        }
+        let cache = KVCache()
+        let k = tensor(17), v = tensor(17, 1)
+        cache.append(k, v)
+        c.equal("Q8 payload uses uint32 packing", cache.keys!.dtype, .uint32)
+        c.equal("metadata uses BF16", cache.keyScales!.dtype, .bfloat16)
+        c.equal("all six allocations are charged", cache.allocatedBytes, 1024 * 1088)
+        let (dk, dv) = cache.fetched()
+        let reconstruction = max(delta(k, dk), delta(v, dv))
+        c.measure("reconstruction_max_absolute_error", Double(reconstruction))
+        c.expect("bounded error on varied BF16 keys/values", reconstruction < 0.05)
+        c.expect("planner prices packed KV plus unquantized indexer", ContextGeometry.rowBytes == 1344)
+        c.expect("prefix charge matches twelve attention layers", PrefixCache.bytesPerToken == 12 * 1344)
+        for rows in [1, 2, 3, 4, 5, 8] {
+            let q = tensor(rows, 2, heads: 24)
+            let positions = MLXArray((17-rows..<17).map(Int32.init)).reshaped([1, 1, rows, 1])
+            let positionsK = MLXArray((0..<17).map(Int32.init)).reshaped([1, 1, 1, 17])
+            let causal = positions .>= positionsK
+            // Also exercise sparse QSA visibility: invisible keys have extreme
+            // values in a separate test below, so a dropped mask cannot pass.
+            let sparse = causal .&& (positionsK % 3 .!= 0)
+            for (name, mask) in [("causal", causal), ("sparse", sparse)] {
+                let actual = cache.attend(q, scale: 0.0625, mask: mask)
+                let oracle = MLXFast.scaledDotProductAttention(queries: q, keys: dk, values: dv,
+                    scale: 0.0625, mask: .array(mask))
+                let error = delta(actual, oracle)
+                c.measure("attention_\(name)_\(rows)_max_error", Double(error))
+                c.expect("Q8 GQA matches dequantized SDPA, \(rows) rows \(name)", error < 0.08, "error=\(error)")
+            }
+            let implicit = cache.attend(q, scale: 0.0625, mask: nil)
+            let explicit = cache.attend(q, scale: 0.0625, mask: causal)
+            c.expect("implicit causal mask matches explicit for \(rows) queries", delta(implicit, explicit) == 0)
+        }
+        let maskedCache = KVCache()
+        let hidden = MLXArray.full([1, 2, 17, 256], values: MLXArray(Float(10000)), dtype: .bfloat16)
+        hidden[0..., 0..., 0..<1, 0...] = MLXArray.full([1, 2, 1, 256], values: MLXArray(Float(0.5)), dtype: .bfloat16)
+        maskedCache.append(k, hidden)
+        let visible = MLXArray((0..<17).map { $0 == 0 }).reshaped([1, 1, 1, 17])
+        let maskedOutput = maskedCache.attend(tensor(1, 2, heads: 24), scale: 0.0625, mask: visible)
+        c.expect("masked extreme values cannot leak into attention", delta(maskedOutput,
+            MLXArray.full(maskedOutput.shape, values: MLXArray(Float(0.5)), dtype: .bfloat16)) == 0)
+        let sibling = KVCache(); cache.copyForPrefix(to: sibling)
+        let original = KVCache(); cache.copyForPrefix(to: original)
+        cache.append(tensor(3, 3), tensor(3, 4))
+        c.expect("prefix sibling survives append", same(sibling, original))
+        cache.trim(to: 17)
+        cache.append(tensor(4, 5), tensor(4, 6))
+        sibling.append(tensor(4, 5), tensor(4, 6))
+        c.expect("speculative rollback overwrites rejected KV and metadata exactly", same(cache, sibling))
+        c.equal("rollback retains reusable capacity", cache.allocatedBytes, 1024 * 1088)
+        let boundary = KVCache()
+        boundary.append(tensor(1023), tensor(1023, 1))
+        let branch = KVCache(); boundary.copyForPrefix(to: branch)
+        boundary.append(tensor(4, 2), tensor(4, 3))
+        c.equal("step crossing charges all six grown buffers", boundary.allocatedBytes, 2048 * 1088)
+        c.equal("growth leaves sibling capacity unchanged", branch.allocatedBytes, 1024 * 1088)
+        boundary.trim(to: 1023)
+        c.expect("growth preserves committed bytes across rollback", same(boundary, branch))
+        for value: Float in [0, 1, -1, 0.0001] {
+            let constant = KVCache()
+            let a = MLXArray.full([1, 2, 1, 256], values: MLXArray(value), dtype: .bfloat16)
+            constant.append(a, a)
+            let (restored, _) = constant.fetched()
+            c.expect("constant/zero group remains finite (\(value))", all(isFinite(restored)).item(Bool.self))
+            c.expect("constant/zero group round trip (\(value))", delta(a, restored) <= max(abs(value) * 0.01, 1e-7))
+        }
+        c.measure("kv_storage_fraction_of_bf16", Double(cache.allocatedBytes) / Double(1024 * 2048))
+        return c.report()
+    }
+}
diff --git a/Sources/SlotstreamDiagnostics/Diagnostics+Q8CachePerformance.swift b/Sources/SlotstreamDiagnostics/Diagnostics+Q8CachePerformance.swift
new file mode 100644
index 0000000..16d4751
--- /dev/null
+++ b/Sources/SlotstreamDiagnostics/Diagnostics+Q8CachePerformance.swift
@@ -0,0 +1,62 @@
+import Foundation
+import MLX
+import MLXFast
+import Slotstream
+
+extension Diagnostics {
+    public static func q8CachePerformance() -> CheckReport {
+        MLX.Memory.cacheLimit = 64 << 20
+        var c = CheckBuilder("q8-cache-performance")
+        for length in [16_384, 131_072] {
+            let cache = KVCache()
+            let row = MLXArray((0..<512).map { sin(Float($0) * 0.137) }).reshaped([1, 2, 1, 256]).asType(.bfloat16)
+            let k = broadcast(row, to: [1, 2, length, 256])
+            let v = broadcast(row * 0.5, to: k.shape)
+            cache.append(k, v); cache.materialize()
+            let q = broadcast(row[0..., 0..<1, 0..., 0...], to: [1, 24, 1, 256])
+            func packed() -> MLXArray { cache.attend(q, scale: 0.0625, mask: nil) }
+            func expanded() -> MLXArray {
+                let (dk, dv) = cache.fetched()
+                return MLXFast.scaledDotProductAttention(queries: q, keys: dk, values: dv, scale: 0.0625, mask: .none)
+            }
+            let a = packed(), b = expanded(); eval(a, b)
+            c.expect("finite Q8 attention at \(length) tokens", all(isFinite(a)).item(Bool.self))
+            let error = abs(a.asType(.float32) - b.asType(.float32)).max().item(Float.self)
+            c.expect("long attention agrees with expanded oracle at \(length)", error < 0.025, "\(error)")
+            c.equal("exact long cache storage at \(length)", cache.allocatedBytes, length * 1088)
+            var times: [[Double]] = [[], [], []]
+            for round in 0..<6 {
+                for mode in (round % 2 == 0 ? [0, 1, 2] : [2, 1, 0]) {
+                    let start = DispatchTime.now().uptimeNanoseconds
+                    for _ in 0..<5 { eval(mode == 0 ? packed() : mode == 1 ? expanded() : cache.attendQMM(q, scale: 0.0625, mask: nil)) }
+                    times[mode].append(Double(DispatchTime.now().uptimeNanoseconds - start) / 5e6)
+                }
+            }
+            for (mode, name) in [(0, "fused"), (1, "expanded"), (2, "qmm")] {
+                let sorted = times[mode].sorted()
+                c.measure("\(length)_\(name)_median_ms", (sorted[2] + sorted[3]) / 2)
+            }
+            let indices = MLXArray((0..<length).map(Int32.init)).reshaped([1, 1, 1, length])
+            let sparse = (indices .< 2048) .|| (indices .>= length - 4)
+            var sparseTimes: [[Double]] = [[], []]
+            func sparseRun(_ mode: Int) -> MLXArray {
+                mode == 0 ? cache.attend(q, scale: 0.0625, mask: sparse)
+                    : cache.attendQMM(q, scale: 0.0625, mask: sparse)
+            }
+            eval(sparseRun(0), sparseRun(1))
+            for round in 0..<6 {
+                for mode in (round % 2 == 0 ? [0, 1] : [1, 0]) {
+                    let start = DispatchTime.now().uptimeNanoseconds
+                    for _ in 0..<5 { eval(sparseRun(mode)) }
+                    sparseTimes[mode].append(Double(DispatchTime.now().uptimeNanoseconds - start) / 5e6)
+                }
+            }
+            for (mode, name) in [(0, "fused"), (1, "qmm")] {
+                let sorted = sparseTimes[mode].sorted()
+                c.measure("\(length)_sparse_\(name)_median_ms", (sorted[2] + sorted[3]) / 2)
+            }
+            c.measure("\(length)_allocated_bytes", Double(cache.allocatedBytes))
+        }
+        return c.report()
+    }
+}
