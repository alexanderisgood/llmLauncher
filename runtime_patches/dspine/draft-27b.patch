 from .config import DraftConfig, load_draft_config, resolve_draft_path
 
 
+class SlidingDraftCache:
+    """The most recent W - 1 committed context rows, with absolute positions."""
+
+    def __init__(self, window: int):
+        self.limit = window - 1
+        self.offset = 0
+        self.keys = None
+        self.values = None
+
+    def append(self, keys, values, end: int) -> None:
+        # The caller already dropped old rows from oversized incoming chunks.
+        # A proposal block never enters this cache, so no rollback is needed.
+        keep = self.limit - keys.shape[2]
+        if keep > 0 and self.keys is not None:
+            keys = mx.concatenate([self.keys[:, :, -keep:, :], keys], axis=2)
+            values = mx.concatenate([self.values[:, :, -keep:, :], values], axis=2)
+        self.keys, self.values = mx.contiguous(keys), mx.contiguous(values)
+        self.offset = end
+
+
