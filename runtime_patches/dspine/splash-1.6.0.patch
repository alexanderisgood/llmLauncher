+  if (!descriptor.externalDraft)
+    throw std::invalid_argument("dspine-model-size requires a target-only DSpine assembly");
+  const model::StreamableWeights weights = model::streamableWeights(root, descriptor, {});
+  kv::Layout kv = descriptor.targetKvLayout;
+  kv.format = kv::Format::Int8;
+  json::Writer w;
+  w.object([&] {
+    w.field("target_weights_bytes", weights.loadedBytes)
+        .field("draft_weights_bytes", 0)
+        .field("int8_kv_bytes_per_page", kv.bytesPerModelPage())
+        .field("kv_page_tokens", kv::kPageTokens)
+        .field("int8_kv_minimum_extent_pages", kv.minimumExtentPages())
+        .field("lane_state_bytes", descriptor.stateLayout.laneBytes())
+        .field("cached_state_bytes", descriptor.stateLayout.cachedBytes())
+        .field("max_context_tokens", descriptor.capabilities.maximumContextTokens);
+  });
+  std::printf("%s\n", w.str().c_str());
+  return 0;
+}
