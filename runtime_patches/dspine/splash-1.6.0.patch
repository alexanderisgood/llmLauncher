diff --git a/runtime/model/DSpineBridge.hpp b/runtime/model/DSpineBridge.hpp
new file mode 100644
--- /dev/null
+++ b/runtime/model/DSpineBridge.hpp
@@ -0,0 +1,172 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace splash::model {
+
+inline constexpr uint32_t kDSpineContext = 262144;
+inline constexpr uint32_t kDSpinePromptRows = 8191;
+
+inline constexpr uint32_t dspinePromptStart(uint32_t promptTokens) {
+  return promptTokens > kDSpinePromptRows ? promptTokens - kDSpinePromptRows : 0;
+}
+inline constexpr uint32_t kDSpineHiddenWidth = 25600;
+inline constexpr uint32_t kDSpineVocabulary = 248320;
+inline constexpr std::array<uint32_t, 5> kDSpineTaps{1, 16, 31, 46, 61};
+
+// An explicit experimental opt-in for an already running, owned local sidecar.
+inline const std::string &dspineSocket() {
+  static const std::string path = [] {
+    const char *value = std::getenv("SPLASH_EXPERIMENTAL_DSPINE_SOCKET");
+    return value ? std::string(value) : std::string{};
+  }();
+  return path;
+}
+
+class DSpineBridge final {
+public:
+  explicit DSpineBridge(uint32_t start) : position_(start) {
+    if (start >= kDSpineContext)
+      throw std::runtime_error("DSpine prompt starts beyond its context limit");
+    static_assert(std::endian::native == std::endian::little);
+    sockaddr_un address{};
+    const std::string &path = dspineSocket();
+    struct stat info{};
+    if (path.empty() || path.front() != '/' || path.size() >= sizeof(address.sun_path) ||
+        lstat(path.c_str(), &info) != 0 || !S_ISSOCK(info.st_mode) ||
+        info.st_uid != getuid() || (info.st_mode & 0077))
+      throw std::runtime_error("DSpine needs an absolute private Unix socket owned by this user");
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+    fd_ = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd_ < 0) fail("socket");
+    try {
+      const int yes = 1;
+      if (fcntl(fd_, F_SETFD, FD_CLOEXEC) < 0 || fcntl(fd_, F_SETFL, O_NONBLOCK) < 0 ||
+          setsockopt(fd_, SOL_SOCKET, SO_NOSIGPIPE, &yes, sizeof(yes)) < 0)
+        fail("socket options");
+      if (connect(fd_, reinterpret_cast<const sockaddr *>(&address), sizeof(address)) < 0) {
+        if (errno != EINPROGRESS && errno != EINTR) fail("connect");
+        wait(POLLOUT, Clock::now() + kTimeout);
+        int error = 0;
+        socklen_t size = sizeof(error);
+        if (getsockopt(fd_, SOL_SOCKET, SO_ERROR, &error, &size) < 0) fail("connect status");
+        if (error) {
+          errno = error;
+          fail("connect");
+        }
+      }
+      exchange({1, 0, 0, 0}, {}, {});
+    } catch (...) {
+      close(fd_);
+      throw;
+    }
+  }
+
+  ~DSpineBridge() { close(fd_); }
+  DSpineBridge(const DSpineBridge &) = delete;
+  DSpineBridge &operator=(const DSpineBridge &) = delete;
+
+  uint32_t position() const noexcept { return position_; }
+
+  void append(uint32_t position, uint32_t rows, std::span<const uint16_t> values) {
+    if (position != position_ || !rows || rows > kDSpineContext - position_ ||
+        values.size() != size_t{rows} * kDSpineHiddenWidth)
+      throw std::runtime_error("DSpine target captures do not form a contiguous BF16 history");
+    const auto bytes = std::as_bytes(values);
+    exchange({2, position, rows, static_cast<uint32_t>(bytes.size())}, bytes, {});
+    position_ += rows;
+  }
+
+  void propose(uint32_t position, uint32_t anchor, std::span<uint32_t> tokens) {
+    if (position != position_ || !position || anchor >= kDSpineVocabulary ||
+        tokens.size() > 7 || position + tokens.size() + 1 > kDSpineContext)
+      throw std::runtime_error("DSpine proposal does not match the retained target history");
+    exchange({3, anchor, static_cast<uint32_t>(tokens.size() + 1), 0}, {}, std::as_writable_bytes(tokens));
+    if (std::ranges::any_of(tokens, [](uint32_t token) { return token >= kDSpineVocabulary; }))
+      throw std::runtime_error("DSpine proposed an out-of-vocabulary token");
+  }
+
+private:
+  using Clock = std::chrono::steady_clock;
+  static constexpr auto kTimeout = std::chrono::seconds(60);
+  using Header = std::array<uint32_t, 4>;
+  int fd_ = -1;
+  uint32_t position_ = 0;
+
+  [[noreturn]] static void fail(const char *action) {
+    const int error = errno;
+    throw std::runtime_error(std::string("DSpine socket ") + action + ": " + std::strerror(error));
+  }
+
+  void wait(short events, Clock::time_point deadline) const {
+    for (;;) {
+      const auto remaining = std::chrono::ceil<std::chrono::milliseconds>(deadline - Clock::now());
+      if (remaining.count() <= 0) throw std::runtime_error("DSpine sidecar timed out");
+      pollfd descriptor{fd_, events, 0};
+      const int result = poll(&descriptor, 1, static_cast<int>(remaining.count()));
+      if (result < 0 && errno == EINTR) continue;
+      if (result < 0) fail("poll");
+      if (!result) throw std::runtime_error("DSpine sidecar timed out");
+      if (descriptor.revents & events) return;
+      throw std::runtime_error("DSpine sidecar disconnected");
+    }
+  }
+
+  template <class Byte>
+  void transfer(std::span<Byte> bytes, Clock::time_point deadline) const {
+    constexpr bool sending = std::is_const_v<Byte>;
+    while (!bytes.empty()) {
+      wait(sending ? POLLOUT : POLLIN, deadline);
+      ssize_t count;
+      if constexpr (sending)
+        count = send(fd_, bytes.data(), bytes.size(), 0);
+      else
+        count = recv(fd_, bytes.data(), bytes.size(), 0);
+      if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+      if (count < 0) fail(sending ? "send" : "receive");
+      if (!count) throw std::runtime_error("DSpine sidecar disconnected");
+      bytes = bytes.subspan(static_cast<size_t>(count));
+    }
+  }
+
+  void exchange(const Header &request, std::span<const std::byte> payload,
+                std::span<std::byte> result) const {
+    const auto deadline = Clock::now() + kTimeout;
+    transfer(std::span<const std::byte>(std::as_bytes(std::span(request))), deadline);
+    transfer(payload, deadline);
+    Header reply{};
+    transfer(std::span<std::byte>(std::as_writable_bytes(std::span(reply))), deadline);
+    if (reply[1] || reply[2]) throw std::runtime_error("DSpine sidecar returned an invalid header");
+    if (reply[0]) {
+      std::array<std::byte, 2048> error{};
+      if (reply[3] > error.size()) throw std::runtime_error("DSpine sidecar returned an oversized error");
+      transfer(std::span(error).first(reply[3]), deadline);
+      throw std::runtime_error("DSpine sidecar: " +
+                               std::string(reinterpret_cast<const char *>(error.data()), reply[3]));
+    }
+    if (reply[3] != result.size()) throw std::runtime_error("DSpine sidecar returned an invalid payload size");
+    transfer(result, deadline);
+  }
+};
+
+} // namespace splash::model
