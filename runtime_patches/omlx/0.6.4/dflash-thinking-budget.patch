+def _generation_finish_reason(summary, max_tokens, stop_ids, parser_final=None):
+    """Use the committed native stop tokens, including EOS at the limit."""
+    if summary is None:
+        return "error"
+    stopped = any(int(token) in stop_ids for token in summary.generated_token_ids)
+    if not stopped and int(summary.generation_tokens) >= max_tokens:
+        return "length"
+    if parser_final is not None and parser_final.finish_reason:
+        return parser_final.finish_reason
+    return "stop"
 
 
