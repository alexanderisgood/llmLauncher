+// Embedding kernels read BF16/F16 as raw scalar rows (GgufEmbedBF16/F16),
+// unlike projections, whose preparation packs 256-value native blocks.
+// In particular, Flash-Next's original BF16 PLE rows have only 160 values.
+inline constexpr uint32_t gguf_embedding_block_elements(uint32_t format) {
+  return format == GGUF_FMT_BF16 || format == GGUF_FMT_F16 ? 1 : kQuantFormats[format].block_elements;
+}
+inline constexpr uint64_t gguf_embedding_row_bytes(uint32_t format, uint64_t columns) {
+  return format == GGUF_FMT_BF16 || format == GGUF_FMT_F16
+             ? columns * 2
+             : columns / kQuantFormats[format].block_elements * kQuantFormats[format].block_bytes;
+}
