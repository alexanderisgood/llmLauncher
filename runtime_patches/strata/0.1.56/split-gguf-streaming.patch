+bool File::open_split(const std::string& p, std::string& err) {
+    if (!open(p, err)) return false;
+    segments.push_back({p, 0, file_bytes});
+    for (const auto& [name, tensor] : tensors) {
+        if (tensor.offset > file_bytes || tensor.bytes > file_bytes - tensor.offset) {
+            err = "split GGUF: truncated tensor " + name; return false;
+        }
+    }
+    const auto count_it = meta_num.find("split.count");
+    if (count_it == meta_num.end() || count_it->second <= 1) return true;
+    const double count = count_it->second;
+    std::smatch match;
+    if (count < 2 || count > 1024 || count != (int) count || !meta_num.count("split.no") || meta_num["split.no"] != 0 ||
+        !std::regex_match(p, match, std::regex("(.*)-00001-of-([0-9]{5})\\.gguf")) ||
+        std::stoi(match[2].str()) != (int) count) {
+        err = "split GGUF: expected the first shard with matching split metadata"; return false;
+    }
+    const auto total_it = meta_num.find("split.tensors.count");
+    if (total_it == meta_num.end() || total_it->second <= 0) {
+        err = "split GGUF: missing total tensor count"; return false;
+    }
+    uint64_t base = map_bytes;
+    for (int i = 1; i < (int) count; ++i) {
+        char suffix[32]; std::snprintf(suffix, sizeof suffix, "-%05d-of-%05d.gguf", i + 1, (int) count);
+        auto shard = std::make_unique<File>();
+        if (!shard->open(match[1].str() + suffix, err)) return false;
+        if (shard->meta_num["split.no"] != i || shard->meta_num["split.count"] != count ||
+            shard->meta_num["split.tensors.count"] != total_it->second) {
+            err = "split GGUF: shard metadata mismatch"; return false;
+        }
+        if (base > std::numeric_limits<uint64_t>::max() - shard->map_bytes) {
+            err = "split GGUF: offset overflow"; return false;
+        }
+        for (const auto& [name, original] : shard->tensors) {
+            if (original.offset > shard->file_bytes || original.bytes > shard->file_bytes - original.offset) {
+                err = "split GGUF: truncated tensor " + name; return false;
+            }
+            Tensor tensor = original;
+            tensor.offset += base;
+            if (!tensors.emplace(name, std::move(tensor)).second) {
+                err = "split GGUF: duplicate tensor " + name; return false;
+            }
+        }
+        segments.push_back({shard->path, base, shard->file_bytes});
+        base += shard->map_bytes;
+        shards.push_back(std::move(shard));
+    }
+    if ((double) tensors.size() != total_it->second) {
+        err = "split GGUF: total tensor count mismatch"; return false;
+    }
+    return true;
+}
+
 File::~File() {
     if (map) munmap(map, map_bytes);
 }
