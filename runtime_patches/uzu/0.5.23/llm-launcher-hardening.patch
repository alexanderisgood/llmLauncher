+            Some(self.max_context_length.load(Ordering::SeqCst))
+        }
+
+        fn stop_token_ids(&self) -> Option<Box<[u64]>> {
+            Some(Box::new([]))
+        }
+
+        fn sampling_defaults(&self) -> SamplingParameters {
+            SamplingParameters::default()
+        }
