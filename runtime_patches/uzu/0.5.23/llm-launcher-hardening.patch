new file mode 100644
index 0000000000000000000000000000000000000000..0bd0fed1c866b825f0814d5f8ba593d997666b7e
--- /dev/null
+++ b/crates/legacy/cli/src/server/security.rs
@@ -0,0 +1,468 @@
+use std::{
+    fs::{File, OpenOptions},
+    io::{Cursor, Read},
+    path::Path,
+};
+
+use anyhow::{Context, Result, bail};
+use rocket::{
+    Request, catch,
+    http::{ContentType, Status},
+    request::{FromRequest, Outcome},
+    response::{Responder, Response},
+};
+use sha2::{Digest, Sha256};
+use subtle::ConstantTimeEq;
+
+const MIN_API_KEY_BYTES: usize = 32;
+const MAX_API_KEY_BYTES: usize = 512;
+const UNAUTHORIZED_BODY: &str = r#"{"error":{"message":"A valid Bearer credential is required.","type":"authentication_error","param":null,"code":"invalid_api_key"}}"#;
+
+pub struct ServerSecurity {
+    expected_key_digest: [u8; 32],
+    context_limit: u32,
+    max_output_tokens: u32,
+}
+
+impl ServerSecurity {
+    pub fn load(
+        api_key_file: &Path,
+        context_limit: u32,
+        max_output_tokens: u32,
+    ) -> Result<Self> {
+        if context_limit == 0 || max_output_tokens == 0 {
+            bail!("context-limit and max-output-tokens must both be positive");
+        }
+        if max_output_tokens > context_limit {
+            bail!("max-output-tokens cannot exceed context-limit");
+        }
+        let mut key_file = open_private_key_file(api_key_file)?;
+        let mut key = Vec::new();
+        if let Err(error) = key_file.by_ref().take((MAX_API_KEY_BYTES + 3) as u64).read_to_end(&mut key) {
+            key.fill(0);
+            return Err(error).context("Cannot read the API-key file");
+        }
+        if key.ends_with(b"\r\n") {
+            key.truncate(key.len() - 2);
+        } else if key.ends_with(b"\n") {
+            key.truncate(key.len() - 1);
+        }
+        if !(MIN_API_KEY_BYTES..=MAX_API_KEY_BYTES).contains(&key.len()) || !key.iter().all(u8::is_ascii_graphic) {
+            key.fill(0);
+            bail!("The API-key file must contain 32 to 512 visible ASCII bytes");
+        }
+        let expected_key_digest = Sha256::digest(&key).into();
+        key.fill(0);
+        unlink_opened_key_file(api_key_file, &key_file)?;
+        Ok(Self {
+            expected_key_digest,
+            context_limit,
+            max_output_tokens,
+        })
+    }
+
+    pub fn context_limit(&self) -> u32 {
+        self.context_limit
+    }
+
+    pub fn max_output_tokens(&self) -> u32 {
+        self.max_output_tokens
+    }
+
+    pub fn accepts_context(
+        &self,
+        prompt_tokens: usize,
+        output_tokens: u32,
+    ) -> bool {
+        let Ok(output_tokens) = usize::try_from(output_tokens) else {
+            return false;
+        };
+        let Ok(context_limit) = usize::try_from(self.context_limit) else {
+            return false;
+        };
+        prompt_tokens.checked_add(output_tokens).is_some_and(|total| total <= context_limit)
+    }
+
+    fn authorizes_header(
+        &self,
+        header: Option<&str>,
+    ) -> bool {
+        let Some((scheme, candidate)) = header.and_then(|header| header.split_once(' ')) else {
+            return false;
+        };
+        if !scheme.eq_ignore_ascii_case("Bearer") || candidate.is_empty() {
+            return false;
+        }
+        let candidate_digest: [u8; 32] = Sha256::digest(candidate.as_bytes()).into();
+        bool::from(candidate_digest.ct_eq(&self.expected_key_digest))
+    }
+
+    #[cfg(test)]
+    pub(crate) fn for_test(
+        key: &[u8],
+        context_limit: u32,
+        max_output_tokens: u32,
+    ) -> Self {
+        Self {
+            expected_key_digest: Sha256::digest(key).into(),
+            context_limit,
+            max_output_tokens,
+        }
+    }
+}
+
+#[cfg(unix)]
+fn open_private_key_file(path: &Path) -> Result<File> {
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
+
+    let parent = path.parent().context("The API-key file has no parent directory")?;
+    let parent_metadata = parent.symlink_metadata().context("Cannot inspect the API-key directory")?;
+    // SAFETY: geteuid has no preconditions and does not retain pointers.
+    let effective_uid = unsafe { libc::geteuid() };
+    if !parent_metadata.is_dir()
+        || parent_metadata.uid() != effective_uid
+        || parent_metadata.permissions().mode() & 0o777 != 0o700
+    {
+        bail!("The API-key directory must be owner-controlled with mode 0700");
+    }
+
+    let path_metadata = path.symlink_metadata().context("Cannot inspect the API-key file")?;
+    if !path_metadata.is_file() {
+        bail!("The API-key path must be a regular file, not a link");
+    }
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(path)
+        .context("Cannot open the API-key file")?;
+    let metadata = file.metadata().context("Cannot inspect the opened API-key file")?;
+    if !metadata.is_file()
+        || metadata.uid() != effective_uid
+        || metadata.permissions().mode() & 0o777 != 0o600
+        || metadata.nlink() != 1
+        || metadata.dev() != path_metadata.dev()
+        || metadata.ino() != path_metadata.ino()
+    {
+        bail!("The API-key file must be one owner-only regular file with mode 0600");
+    }
+    Ok(file)
+}
+
+#[cfg(not(unix))]
+fn open_private_key_file(_path: &Path) -> Result<File> {
+    bail!("The hardened local server currently requires Unix file permissions")
+}
+
+#[cfg(unix)]
+fn unlink_opened_key_file(
+    path: &Path,
+    file: &File,
+) -> Result<()> {
+    use std::os::unix::fs::MetadataExt;
+
+    let opened = file.metadata().context("Cannot recheck the opened API-key file")?;
+    let current = path.symlink_metadata().context("Cannot recheck the API-key path")?;
+    if !current.is_file() || current.dev() != opened.dev() || current.ino() != opened.ino() {
+        bail!("The API-key file changed while it was being consumed");
+    }
+    std::fs::remove_file(path).context("Cannot unlink the consumed API-key file")?;
+    let unlinked = file.metadata().context("Cannot inspect the consumed API-key file")?;
+    if unlinked.nlink() != 0 {
+        bail!("The consumed API-key file gained another filesystem link");
+    }
+    Ok(())
+}
