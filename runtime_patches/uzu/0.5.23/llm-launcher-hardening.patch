@@ -0,0 +1,42 @@
+use anyhow::{Context, Result, bail};
+use hanashi::{Encoding as EncodingTrait, chat::Encoding};
+use uzu::{
+    session::chat::{ChatInstance, ChatInstanceKind, token::encoding_for_instance},
+    types::session::chat::ChatMessage,
+};
+
+pub struct PromptTokenCounter {
+    encoding: Encoding,
+}
+
+impl PromptTokenCounter {
+    pub fn new(
+        instance: &ChatInstance,
+        expected_context_limit: u32,
+    ) -> Result<Self> {
+        let ChatInstanceKind::Token(token_instance) = instance.kind() else {
+            bail!("The hardened local server requires a token-backed chat model");
+        };
+        let expected_context_limit = usize::try_from(expected_context_limit)
+            .context("The configured context limit cannot be represented on this platform")?;
+        if token_instance.max_context_length() != Some(expected_context_limit) {
+            bail!(
+                "The token backend did not preserve the configured {expected_context_limit}-token native context limit"
+            );
+        }
+        let encoding = encoding_for_instance(token_instance.as_ref(), &instance.reference(), &instance.model())
+            .context("Failed to create the exact prompt counter")?;
+        Ok(Self {
+            encoding,
+        })
+    }
+
+    pub fn count(
+        &mut self,
+        messages: &[ChatMessage],
+    ) -> Result<usize> {
+        self.encoding.reset().context("Failed to reset the prompt counter")?;
+        self.encoding.encode(messages.to_vec()).context("Failed to encode the prompt")?;
+        Ok(self.encoding.state().tokens.len())
+    }
+}
