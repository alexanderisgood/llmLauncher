+        ) -> Pin<
+            Box<
+                dyn InstanceStream<Item = Result<Self::StreamOutput, Error>, Metrics = Self::StreamMetrics> + Send + 'a,
+            >,
+        > {
+            self.stream_inputs.lock().expect("stream input lock").push(input.clone());
+            Box::pin(NoMetricsStream::<_, TokenStreamMetrics>::new(stream::iter([Ok(StreamOutput::LimitReached)])))
+        }
+
+        fn peak_memory_usage(&self) -> Option<usize> {
+            None
+        }
+    }
