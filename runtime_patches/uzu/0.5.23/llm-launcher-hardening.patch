+#[cfg(test)]
+pub(crate) mod test_support {
+    use std::{
+        future::Future,
+        pin::Pin,
+        sync::{
+            Arc, Mutex as StdMutex,
+            atomic::{AtomicUsize, Ordering},
+        },
+    };
+
+    use shoji::{
+        traits::backend::{Instance as BackendInstance, InstanceStream, NoMetricsStream},
+        types::{
+            basic::Value,
+            model::{ModelAccessibility, ModelSpecialization},
+        },
+    };
+    use tokenizers::{
+        AddedToken, Tokenizer,
+        models::bpe::{BPE, Vocab},
+        pre_tokenizers::byte_level::ByteLevel,
+    };
+
+    use super::*;
+
+    #[derive(Debug)]
+    struct FakeState;
+
+    impl State for FakeState {}
+
+    pub(crate) struct FakeTokenInstance {
+        tokenizer: Arc<Tokenizer>,
+        max_context_length: AtomicUsize,
+        state_creations: AtomicUsize,
+        stream_inputs: StdMutex<Vec<Vec<u64>>>,
+    }
+
+    impl FakeTokenInstance {
+        pub(crate) fn new(max_context_length: usize) -> Self {
+            let vocabulary: Vocab = ByteLevel::alphabet()
+                .into_iter()
+                .enumerate()
+                .map(|(index, value)| (value.to_string(), index as u32))
+                .collect();
+            let model =
+                BPE::builder().vocab_and_merges(vocabulary, Vec::new()).build().expect("valid test tokenizer model");
+            let mut tokenizer = Tokenizer::new(model);
+            tokenizer
+                .with_pre_tokenizer(Some(ByteLevel::default().add_prefix_space(false)))
+                .with_decoder(Some(ByteLevel::default()));
+            tokenizer.add_special_tokens(
+                &["<|start_header_id|>", "<|end_header_id|>", "<|eot_id|>", "<|eom_id|>", "<|python_tag|>"]
+                    .into_iter()
+                    .map(|value| AddedToken::from(value, true))
+                    .collect::<Vec<_>>(),
+            );
+            Self {
+                tokenizer: Arc::new(tokenizer),
+                max_context_length: AtomicUsize::new(max_context_length),
+                state_creations: AtomicUsize::new(0),
+                stream_inputs: StdMutex::new(Vec::new()),
+            }
+        }
+
+        pub(crate) fn set_max_context_length(
+            &self,
+            max_context_length: usize,
+        ) {
+            self.max_context_length.store(max_context_length, Ordering::SeqCst);
+        }
+
+        pub(crate) fn state_creation_count(&self) -> usize {
+            self.state_creations.load(Ordering::SeqCst)
+        }
+
+        pub(crate) fn stream_call_count(&self) -> usize {
+            self.stream_inputs.lock().expect("stream input lock").len()
+        }
+    }
+
+    impl BackendInstance for FakeTokenInstance {
+        type StreamConfig = ChatReplyConfig;
+        type StreamInput = StreamInput;
+        type StreamOutput = StreamOutput;
+        type StreamMetrics = Option<TokenStreamMetrics>;
+
+        fn state(&self) -> Pin<Box<dyn Future<Output = Result<Box<dyn State>, Error>> + Send + '_>> {
+            self.state_creations.fetch_add(1, Ordering::SeqCst);
+            Box::pin(async { Ok(Box::new(FakeState) as Box<dyn State>) })
+        }
+
+        fn stream<'a>(
+            &'a self,
+            input: &'a Self::StreamInput,
+            _state: &'a mut dyn State,
+            _config: Self::StreamConfig,
