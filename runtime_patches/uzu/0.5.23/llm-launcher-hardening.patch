+fn context_reservation_fits(
+    live_prompt_tokens: usize,
+    output_tokens: u32,
+    max_context_length: usize,
+) -> bool {
+    usize::try_from(output_tokens)
+        .ok()
+        .and_then(|output| live_prompt_tokens.checked_add(output))
+        .is_some_and(|reserved| reserved <= max_context_length)
