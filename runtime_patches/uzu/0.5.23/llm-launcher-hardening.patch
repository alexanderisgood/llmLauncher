+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use futures::StreamExt;
+
+    use super::{
+        test_support::{FakeTokenInstance, model as test_model},
+        *,
+    };
+
+    #[test]
+    fn live_context_reservation_accepts_the_boundary_and_rejects_one_more() {
+        assert!(context_reservation_fits(12_288, 4_096, 16_384));
+        assert!(!context_reservation_fits(12_289, 4_096, 16_384));
+        assert!(!context_reservation_fits(usize::MAX, 1, usize::MAX));
+    }
+
+    #[tokio::test]
+    async fn rejected_live_context_turn_leaves_token_and_cache_state_unchanged() {
+        let instance = Arc::new(FakeTokenInstance::new(4_096));
+        let model = test_model();
+        let mut session =
+            Session::with_instance(instance.clone(), "unused".to_string(), &model).await.expect("test session");
+        let config = ChatReplyConfig {
+            token_limit: Some(1),
+            ..ChatReplyConfig::default()
+        };
+
+        let prior_messages = vec![ChatMessage::user().with_text("accepted prior turn".to_string())];
+        let prior_outputs = session
+            .stream(&prior_messages, config.clone(), CancellationToken::new())
+            .await
+            .expect("prior turn preflight")
+            .collect::<Vec<_>>()
+            .await;
+        assert_eq!(prior_outputs.len(), 1);
+        assert!(prior_outputs[0].is_ok());
+
+        let prior_encoding_state = session.encoding.state().clone();
+        let prior_input_tokens = session.input_tokens.clone();
+        let prior_state_creations = instance.state_creation_count();
+        let prior_stream_calls = instance.stream_call_count();
+
+        let mut rejected_messages = prior_encoding_state.messages.clone();
+        rejected_messages.push(ChatMessage::user().with_text("rejected overflow turn".to_string()));
+        instance.set_max_context_length(1);
+        let error = session
+            .stream(&rejected_messages, config.clone(), CancellationToken::new())
+            .await
+            .err()
+            .expect("context overflow must be rejected before streaming");
+        assert!(error.to_string().contains("exceeds the native 1-token context"));
+        assert_eq!(session.encoding.state(), &prior_encoding_state);
+        assert_eq!(session.input_tokens, prior_input_tokens);
+        assert_eq!(instance.state_creation_count(), prior_state_creations);
+        assert_eq!(instance.stream_call_count(), prior_stream_calls);
+
+        let mut replacement_messages = prior_encoding_state.messages.clone();
+        let replacement = ChatMessage::user().with_text("accepted replacement turn".to_string());
+        replacement_messages.push(replacement.clone());
+        instance.set_max_context_length(4_096);
+        let replacement_outputs = session
+            .stream(&replacement_messages, config, CancellationToken::new())
+            .await
+            .expect("replacement turn preflight")
+            .collect::<Vec<_>>()
+            .await;
+        assert_eq!(replacement_outputs.len(), 1);
+        assert!(replacement_outputs[0].is_ok());
+        assert_eq!(instance.stream_call_count(), prior_stream_calls + 1);
+        assert!(session.encoding.state().messages.contains(&replacement));
+        assert!(
+            session
+                .encoding
+                .state()
+                .messages
+                .iter()
+                .all(|message| message.text().as_deref() != Some("rejected overflow turn"))
+        );
+    }
+}
