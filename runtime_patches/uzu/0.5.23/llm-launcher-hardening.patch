+pub struct Authorized;
+
+#[rocket::async_trait]
+impl<'r> FromRequest<'r> for Authorized {
+    type Error = ();
+
+    async fn from_request(request: &'r Request<'_>) -> Outcome<Self, Self::Error> {
+        let Some(security) = request.rocket().state::<ServerSecurity>() else {
+            return Outcome::Error((Status::InternalServerError, ()));
+        };
+        let mut authorization_headers = request.headers().get("Authorization");
+        let authorization = authorization_headers.next();
+        if authorization_headers.next().is_none() && security.authorizes_header(authorization) {
+            Outcome::Success(Self)
+        } else {
+            Outcome::Error((Status::Unauthorized, ()))
+        }
+    }
+}
